# Copy to .env (git-ignored). Points the student app at the melda-backend API.
#
# The Anthropic key lives ONLY in the backend - the app never holds it. On-demand
# AI is a teacher-only feature; the student app just reads and submits.
#
# localhost works for web and simulators; a physical device needs the host LAN IP
# (e.g. http://192.168.1.10:4000).
EXPO_PUBLIC_API_URL=http://localhost:4000
