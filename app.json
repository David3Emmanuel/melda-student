{
  "expo": {
    "name": "MELDA Student",
    "slug": "melda-student",
    "scheme": "melda-student",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1439FF"
    },
    "android": {
      "package": "com.melda.student",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1439FF"
      }
    },
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "MELDA Student",
      "shortName": "MELDA Student",
      "themeColor": "#1439FF",
      "backgroundColor": "#F4F5F7",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f55f1690-71fd-4651-ae4a-d7a10e59a22e"
      }
    },
    "owner": "david3emmanuel"
  }
}
