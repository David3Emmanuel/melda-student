{
  "expo": {
    "name": "MELDA Student",
    "slug": "melda-student",
    "scheme": "melda-student",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1439FF"
    },
    "android": {
      "package": "com.melda.student",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1439FF"
      }
    },
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "name": "MELDA Student",
      "shortName": "MELDA Student",
      "themeColor": "#1439FF",
      "backgroundColor": "#F4F5F7",
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router"]
  }
}

